{
  "name": "@compify/sandpack-client",
  "version": "2.19.8",
  "description": "Node-free Compify fork of the Sandpack browser runtime and static clients.",
  "private": true,
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./clients/runtime": {
      "types": "./dist/clients/runtime/index.d.ts",
      "import": "./dist/clients/runtime/index.mjs",
      "require": "./dist/clients/runtime/index.js"
    },
    "./clients/static": {
      "types": "./dist/clients/static/index.d.ts",
      "import": "./dist/clients/static/index.mjs",
      "require": "./dist/clients/static/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist src/inject-scripts/dist",
    "build": "bun run clean && rollup -c rollup.config.js",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "files": [
    "dist",
    "LICENSE",
    "PROVENANCE.md",
    "README.md",
    "package.json",
    "THIRD_PARTY_NOTICES.md",
    "console-feed-LICENSE"
  ],
  "dependencies": {
    "dequal": "^2.0.2",
    "mime-db": "^1.52.0",
    "outvariant": "1.4.0",
    "static-browser-server": "1.0.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubet/compify.git",
    "directory": "packages/compify-pack/sandpack-client"
  },
  "devDependencies": {
    "@types/mime-db": "^1.43.1"
  },
  "packageManager": "bun@1.3.9",
  "engines": {
    "bun": ">=1.3.9"
  }
}
