{
  "name": "@compify/storybook",
  "version": "0.1.0",
  "description": "Renderer-neutral Storybook manager addon for displaying Compify portability and distribution metadata.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/preset.cjs",
  "types": "./dist/preset.d.cts",
  "exports": {
    ".": {
      "types": "./dist/preset.d.cts",
      "require": "./dist/preset.cjs",
      "default": "./dist/preset.cjs"
    },
    "./preset": {
      "types": "./dist/preset.d.cts",
      "require": "./dist/preset.cjs",
      "default": "./dist/preset.cjs"
    },
    "./parameters": {
      "types": "./dist/parameters.d.ts",
      "import": "./dist/parameters.js",
      "default": "./dist/parameters.js"
    },
    "./manager": "./dist/manager.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run test && bun run typecheck && bun run test:package",
    "test:package": "bun run build && bun scripts/check-package.ts"
  },
  "keywords": [
    "storybook",
    "storybook-addon",
    "addon",
    "preset",
    "compify",
    "components",
    "portability",
    "registry"
  ],
  "author": {
    "name": "Compify",
    "url": "https://compify.app"
  },
  "homepage": "https://github.com/kubet/compify/tree/main/packages/storybook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubet/compify.git",
    "directory": "packages/storybook"
  },
  "bugs": {
    "url": "https://github.com/kubet/compify/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.9"
  },
  "packageManager": "bun@1.3.9",
  "peerDependencies": {
    "storybook": ">=8 <11",
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "storybook": "^9.1.17"
  },
  "storybook": {
    "displayName": "Compify portability",
    "icon": "https://compify.app/favicon.ico",
    "unsupportedFrameworks": []
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@storybook/manager-api": "^8.6.14"
  }
}
