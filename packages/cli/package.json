{
  "name": "@compify/cli",
  "version": "0.2.0",
  "description": "CLI tool for installing Compify.app components",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "compify",
    "url": "https://compify.app"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "components",
    "ui",
    "tailwind",
    "compify",
    "cli",
    "design-system"
  ],
  "type": "module",
  "exports": "./dist/index.js",
  "bin": {
    "compify": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "bun dist/index.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "link": "bun link",
    "unlink": "bun unlink",
    "prepublishOnly": "bun run test && bun run build"
  },
  "dependencies": {
    "commander": "^10.0.0",
    "diff": "^5.1.0",
    "fs-extra": "^11.1.0",
    "kleur": "^4.1.5",
    "node-fetch": "^3.3.0",
    "prompts": "^2.4.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/diff": "^5.0.3",
    "@types/fs-extra": "^11.0.1",
    "@types/node": "^18.0.0",
    "@types/prompts": "^2.4.2",
    "esbuild": "^0.28.1",
    "prettier": "^2.8.8",
    "tsup": "^8.5.1",
    "typescript": "^4.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "license": "MIT",
  "homepage": "https://github.com/kubet/compify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubet/compify.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/kubet/compify/issues"
  },
  "engines": {
    "bun": ">=1.3.9"
  },
  "packageManager": "bun@1.3.9"
}
