# Copy to .env in the repository root and replace all development secrets.
POSTGRES_USER=compify
POSTGRES_PASSWORD=replace-with-a-long-random-bootstrap-database-secret
DB_MIGRATOR_PASSWORD=replace-with-a-distinct-long-random-migrator-secret
DB_RUNTIME_PASSWORD=replace-with-a-distinct-long-random-runtime-secret
POSTGRES_DB=compify
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
MINIO_ROOT_USER=compify
MINIO_ROOT_PASSWORD=replace-with-a-long-random-root-secret
MINIO_APP_ACCESS_KEY=compify-app
MINIO_APP_SECRET_KEY=replace-with-a-different-long-random-app-secret
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
JWT_SECRET=replace-with-a-long-random-value
# Set to none only for cross-site web/API URLs (requires HTTPS).
AUTH_COOKIE_SAME_SITE=lax
INTERNAL_API_TOKEN=replace-with-another-long-random-value
WEB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=3009
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3009
# Set SOURCE_REVISION to the exact 40-character Git commit used for the build.
# SOURCE_URL may override the public source location when mirroring the source.
SOURCE_REVISION=
SOURCE_URL=
SOURCE_REPOSITORY=https://github.com/kubet/compify
TRUST_PROXY_HOPS=0
NEXT_PUBLIC_API_URL=http://localhost:3009
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CDN_URL=http://localhost:9000/public
# Optional interactive preview. Compify does not include a Sandpack bundler.
# Set this to the absolute URL of a compatible bundler deployment to enable it.
NEXT_PUBLIC_BUNDLER_URL=
# Capabilities are disabled by default. Enabling Turnstile requires both its
# public site key and secret below; enabling Google requires both credentials.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
GOOGLE_OAUTH_ENABLED=false
# Optional integrations (uncomment/configure as needed)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_AI_API_KEY=
# GROQ_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# FREE_PLAN_ID=00000000-0000-4000-8000-000000000001
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CLOUDFLARE_TURNSTILE_KEY=
# ZEPTOMAIL_API_URL=
# ZEPTOMAIL_API_TOKEN=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=Compify
