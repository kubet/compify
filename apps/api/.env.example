# Copy to .env.stage.local (dev) or .env.stage.prod (prod) and fill in.
# The app reads .env.stage.<STAGE> where STAGE is set by the start script.

# Server
PORT=3009
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3009

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=compify

# Auth (required; use a long random value)
JWT_SECRET=

# MinIO (required; create buckets: components, images, public, projects)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Shared secret for internal endpoints (sitemap fetch); must match the web app
INTERNAL_API_TOKEN=

# AI providers (optional — AI features degrade gracefully without them)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=

# SMTP / email (optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=Compify <no-reply@example.com>

# ZeptoMail (optional alternative used by some email flows)
ZEPTOMAIL_API_URL=api.zeptomail.eu/
ZEPTOMAIL_API_TOKEN=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Compify

# Cloudflare Turnstile (optional; registration verification)
CLOUDFLARE_TURNSTILE_KEY=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe/billing. The current server requires these at startup; see
# docs/open-source-readiness.md before running without billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FREE_PLAN_ID=
