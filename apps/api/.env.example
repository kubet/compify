# Copy to .env.stage.local (dev) or .env.stage.prod (prod) and fill in.
# The app reads .env.stage.<STAGE> where STAGE is set by the start script.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=compify

# Auth
JWT_SECRET=

# MinIO (buckets: components, images, public, projects)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# AI providers (optional — AI features degrade gracefully without them)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=

# Email (ZeptoMail)
ZEPTOMAIL_API_URL=api.zeptomail.eu/
ZEPTOMAIL_API_TOKEN=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Compify

# Cloudflare Turnstile (register form)
CLOUDFLARE_TURNSTILE_KEY=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FREE_PLAN_ID=

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3091

# Shared secret for internal endpoints (sitemap fetch); must match the web app
INTERNAL_API_TOKEN=
