# Copy this file to .env (or .env.stage.<name> and set STAGE=<name>).
# Blank optional integration values may be removed entirely.

# Runtime
NODE_ENV=development
PORT=3009
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3009
# Set to the exact number of trusted reverse proxies in front of the API.
TRUST_PROXY_HOPS=0

# PostgreSQL (required)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=compify
# Schema synchronization is unsafe by default. It is honored only when
# NODE_ENV=development; prefer the migration:* scripts for shared databases.
DB_SYNCHRONIZE=false

# Auth (required; generate a unique secret of at least 32 characters)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Defaults to lax. Use none only when web and API are on different sites; HTTPS is required.
AUTH_COOKIE_SAME_SITE=lax

# MinIO (required; use a least-privilege application user for these buckets)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=compify-app
MINIO_SECRET_KEY=replace-me

# Internal web/API calls (optional; sitemap endpoint is unavailable without it)
INTERNAL_API_TOKEN=

# AI providers (optional; configure the providers used by your enabled AI features)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=

# Transactional email via ZeptoMail (optional). Set URL, token, and from address
# together. Email-dependent actions return 503 while this is disabled.
ZEPTOMAIL_API_URL=
ZEPTOMAIL_API_TOKEN=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Compify

# Cloudflare Turnstile (optional). Enabling requires both values.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_KEY=

# Google OAuth (optional). Enabling requires both credentials.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe billing (optional). Billing routes return 503 without a secret key.
# STRIPE_WEBHOOK_SECRET is additionally required for the webhook route.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required only when automatic free-plan assignment is used.
FREE_PLAN_ID=
