# Public API endpoint compiled into the browser bundle
NEXT_PUBLIC_API_URL=http://localhost:3009
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CDN_URL=http://localhost:9000/public
# Required for the interactive editor; deploy a compatible Sandpack bundler.
NEXT_PUBLIC_BUNDLER_URL=http://localhost:3000/sandpack

# Copy to .env and fill in.

# Cloudflare Turnstile site key (public) for the register form
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Shared secret for internal API endpoints (sitemap); must match the api app
INTERNAL_API_TOKEN=
