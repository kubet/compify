# Public API endpoint compiled into the browser bundle
NEXT_PUBLIC_API_URL=http://localhost:3009
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CDN_URL=http://localhost:9000/public
# Public corresponding-source offer. Production should pin the exact deployed commit.
NEXT_PUBLIC_SOURCE_URL=
NEXT_PUBLIC_SOURCE_REVISION=
NEXT_PUBLIC_SOURCE_REPOSITORY=https://github.com/kubet/compify
# Optional: required to enable the interactive preview. Compify does not ship a
# Sandpack bundler; provide the absolute URL of a compatible deployment.
NEXT_PUBLIC_BUNDLER_URL=

# Copy to .env and fill in.

# Cloudflare Turnstile configuration for the register form. Enabling it also
# requires TURNSTILE_ENABLED=true and the secret in the API app.
NEXT_PUBLIC_TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Set true only when GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are configured on
# the API. This only controls public UI and does not expose either secret.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# Shared secret for internal API endpoints (sitemap); must match the api app
INTERNAL_API_TOKEN=
